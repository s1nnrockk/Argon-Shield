{
  "manifest_version": 3,
  "name": "Argon Shield",
  "version": "1.1.0",
  "description": "Cyberpunk Firefox proxy manager with connection diagnostics and domain routing rules.",
  "permissions": [
    "proxy",
    "storage",
    "activeTab",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Argon Shield",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "argon-shield@s1nnrockk.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo"
        ]
      }
    }
  }
}